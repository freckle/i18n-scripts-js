{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist && rm -f dist/*.test.js",
    "coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' '*.{js,mjs}'",
    "format-check": "prettier --check 'src/**/*.js' '*.{js,mjs}'",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.336.0",
    "i18next": "26.4.7",
    "i18next-http-backend": "^4.0.3",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.2",
    "@freckle/prettier-config": "^1.3.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "prettier": "@freckle/prettier-config"
}
