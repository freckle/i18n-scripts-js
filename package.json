{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -r dist && cp -r src dist",
    "format": "prettier --write 'src/**/*.js'",
    "format-check": "prettier --check 'src/**/*.js'",
    "lint": "eslint"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.333.0",
    "i18next": "26.4.2",
    "i18next-http-backend": "^4.0.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^12.1.2"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.2.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
