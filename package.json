{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist && rm -f dist/*.test.js",
    "coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' '*.{js,mjs}'",
    "format-check": "prettier --check 'src/**/*.js' '*.{js,mjs}'",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.342.0",
    "i18next": "27.2.3",
    "i18next-http-backend": "^4.1.0",
    "i18next-icu": "^2.7.1",
    "intl-messageformat": "^12.2.0"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.6",
    "@freckle/prettier-config": "^1.3.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "prettier": "@freckle/prettier-config"
}
