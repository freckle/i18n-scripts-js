{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -r dist && cp -r src dist",
    "format": "prettier --write 'src/**/*.js'",
    "format-check": "prettier --check 'src/**/*.js'",
    "lint": "eslint"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.333.0",
    "i18next": "26.4.2",
    "i18next-http-backend": "^4.0.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^12.1.2"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.2.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
