{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist && rm -f dist/*.test.js",
    "coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' '*.{js,mjs}'",
    "format-check": "prettier --check 'src/**/*.js' '*.{js,mjs}'",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.335.0",
    "i18next": "26.4.2",
    "i18next-http-backend": "^4.0.2",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.1",
    "@freckle/prettier-config": "^1.3.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "prettier": "@freckle/prettier-config"
}
