{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist && rm -f dist/*.test.js",
    "coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' '*.{js,mjs}'",
    "format-check": "prettier --check 'src/**/*.js' '*.{js,mjs}'",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.337.0",
    "i18next": "26.5.11",
    "i18next-http-backend": "^4.0.6",
    "i18next-icu": "^2.6.1",
    "intl-messageformat": "^12.1.4"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.4",
    "@freckle/prettier-config": "^1.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "prettier": "@freckle/prettier-config"
}
