{
  "name": "@freckle/i18n-scripts",
  "version": "1.0.0",
  "description": "Scripts for i18n",
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "check-i18n-variables": "./dist/check-i18n-variables.js",
    "check-i18next-icu-parser": "./dist/check-i18next-icu-parser.js",
    "check-missing-translations": "./dist/check-missing-translations"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/i18n-scripts-js.git"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist && rm -f dist/*.test.js",
    "coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' '*.{js,mjs}'",
    "format-check": "prettier --check 'src/**/*.js' '*.{js,mjs}'",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "esprima-walk": "0.1.0",
    "flow-parser": "0.339.0",
    "i18next": "27.1.1",
    "i18next-http-backend": "^4.0.10",
    "i18next-icu": "^2.7.0",
    "intl-messageformat": "^12.1.5"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.4",
    "@freckle/prettier-config": "^1.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb",
  "prettier": "@freckle/prettier-config"
}
